{
  "name": "core-erp-client",
  "version": "0.1.0",
  "description": "Core ERP Client — Electron desktop app for Core ERP APIs",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "npx tsx scripts/build-main.ts --watch",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development npx tsx scripts/launch-electron.ts dist/main/index.cjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "npx tsx scripts/build-main.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "start": "electron dist/main/index.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "publish-release": "npx tsx scripts/publish-release.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "lucide-react": "^1.24.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "serialport": "^13.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.byteb.core-erp-client",
    "productName": "Core ERP Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Byte-Builders-Co",
        "repo": "core-erp-client",
        "private": true
      }
    ]
  },
  "author": "Byte Builders Co",
  "license": "MIT"
}
